# Ne jamais committer de vrai token/mot de passe ici.
# Sur Replit : onglet "Secrets" (icone cadenas) -> ajouter les variables ci-dessous.
# Sans elles, chaque source tourne en mode demo (HubSpot: donnees reelles
# gelees ; Odoo: exemple illustratif). Le CRM basique eTeamsys ne necessite
# aucune variable : il fonctionne toujours, en local (fichier data/crm-basique.json).

HUBSPOT_TOKEN=

ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_PASSWORD=

# Copilote génératif (facultatif : sans clé, réponses déterministes de démonstration).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
