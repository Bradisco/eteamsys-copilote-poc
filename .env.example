# Ne jamais committer de vrai token/mot de passe ici.
# Sur Replit : onglet "Secrets" (icone cadenas) -> ajouter les variables ci-dessous.
# Les identifiants HubSpot/Odoo se gèrent par profil dans le backoffice interne.
# Sans identifiants, chaque profil externe affiche sa démonstration.
# Le CRM basique fonctionne en local, sans identifiants externes.

# Copilote génératif (facultatif : sans clé, réponses déterministes de démonstration).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
